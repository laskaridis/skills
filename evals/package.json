{
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^6.0.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.1.1",
    "dependency-cruiser": "^18.9.0",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  },
  "name": "agent-skills-evals",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.1",
  "engines": {
    "node": ">=22.21.0"
  },
  "scripts": {
    "eval": "node --experimental-strip-types run.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "lint:deps": "depcruise --config .dependency-cruiser.mjs run.ts lib skills tests",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "pnpm lint:fix && pnpm format && pnpm lint && pnpm lint:deps && pnpm typecheck && pnpm test:coverage"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  }
}
